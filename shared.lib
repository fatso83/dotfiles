# vi: ft=bash

# since this is sourced from ANYWHERE, we need to know the root to be able to
# source other files


error(){
    if ! command -v dark_red; then
        printf "ERROR: %s\n" "$@" >&2
    else
        printf "ERROR: %s\n" "$(dark_red "$@")" >&2
    fi
    exit 1
}

if [[ "$ROOT" == "" ]]; then
    error "Missing ROOT environment variable (in ${BASH_SOURCE[0]}). Should point to git repo root"
    return 1
fi

# These are set to avoid errors in the sourced files
BASH_D="$ROOT/common-setup/bash.d"
# shellcheck disable=SC2034
BIN_DIR="$ROOT/utils/scripts"
source "$BASH_D/colors"
source "$BASH_D/aliases_functions"
shopt -s expand_aliases

download_if_not_exist(){
    local url="$1"
    local file="$2"

    if [[ ! -e $file ]]; then
        curl -s --fail -L -o "$file" "$url"
    fi
}

# Makes mise and its shims available to non-interactive setup scripts.
# ~/.local/bin is only added to PATH by ~/.profile, which a first run has not read yet.
# Safe to call before mise is installed (no-op).
MISE_BIN="$HOME/.local/bin/mise"
use_mise_shims(){
    if [[ -x "$MISE_BIN" ]]; then
        case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) export PATH="$HOME/.local/bin:$PATH";; esac
        eval "$("$MISE_BIN" activate bash --shims)"
    fi
}

# header1
h1() {
    printf "%s\n" "$(green "$@")"
}

h2(){
    printf "%s\n" "$(blue "$@")"
}

h3(){
    printf "%s %s\n" "-->" "$(blue "$@")"
}

info(){
    printf "%s\n" "$(pink "$@")"
}

warn(){
    printf "%s\n" "$(dark_yellow "$@")" >&2
}

TODO(){
    info "TODO: $@"
}

banner(){
    printf "\n################################################################################\n"
    printf "##    %s\n" "$(dark_red "$@")"
    printf "################################################################################\n"
}

fail(){
    banner "$@"
    exit 1
}


add_1password_identity_agent_ssh_config(){
    local dotfiles_root
    dotfiles_root="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    "$dotfiles_root/common-setup/chezmoi-ssh.sh"
}
